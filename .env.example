# Copy to .env and fill in. NEVER commit .env.
PORT=3456
SYNC_INTERVAL_MINUTES=30
MONTHS_BACK=6

# Master passphrase for the encrypted credentials vault (data/vault.enc).
# Leave empty to be prompted on start (more secure, but no unattended restarts).
DASHBANK_PASSPHRASE=

# Telegram: create a bot with @BotFather, then get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy: pick a long random topic name; subscribe to it in the ntfy phone app
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Only notify for outgoing charges at or above this amount (0 = every charge)
NOTIFY_MIN_AMOUNT=0

# ---- Dashboard login (npm run auth-setup) ----
# Secret used to sign login cookies and encrypt the TOTP secret in data/auth.json (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out and requires re-running npm run auth-setup.
AUTH_SECRET=

# Public HTTPS address of the dashboard, e.g. your Tailscale URL (no trailing slash):
# PUBLIC_URL=https://my-pc.tail1234.ts.net
PUBLIC_URL=

# Optional "Sign in with Google" (enabled only when all of the following and PUBLIC_URL are set).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application),
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
# Google sign-in replaces the TOTP step: the Google account's own 2-Step Verification is the second factor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in
AUTH_ALLOWED_EMAILS=
