# Copy to .env and fill in. NEVER commit .env.
PORT=3456
SYNC_INTERVAL_MINUTES=30
MONTHS_BACK=6

# Master passphrase for the encrypted credentials vault (data/vault.enc).
# Leave empty to be prompted on start (more secure, but no unattended restarts).
DASHBANK_PASSPHRASE=

# Telegram: create a bot with @BotFather, then get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy: pick a long random topic name; subscribe to it in the ntfy phone app
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Only notify for outgoing charges at or above this amount (0 = every charge)
NOTIFY_MIN_AMOUNT=0

# Notification language: he | en
NOTIFY_LANG=he
# 1 = privacy mode: lock-screen title shows amount + category only, never the merchant name
NOTIFY_PRIVACY=0

# Contact for accessibility issues, shown in the accessibility statement (default: "the system owner")
ACCESSIBILITY_CONTACT=
