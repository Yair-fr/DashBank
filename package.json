{
  "name": "dashbank",
  "version": "1.0.0",
  "private": true,
  "description": "Personal finance tracker for Israeli bank & credit cards with dashboard and push notifications",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "demo": "node --disable-warning=ExperimentalWarning src/index.js --demo",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "auth-setup": "node --disable-warning=ExperimentalWarning scripts/auth-setup.js",
    "sync": "node --disable-warning=ExperimentalWarning src/index.js --once",
    "test-notify": "node --disable-warning=ExperimentalWarning scripts/test-notify.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "autostart": "node --disable-warning=ExperimentalWarning scripts/autostart.js",
    "screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "israeli-bank-scrapers": "^6.12.2",
    "node-cron": "^4.2.1"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "zod": "4.6.7",
    "extract-zip": "2.0.1",
    "puppeteer": "25.16.0",
    "puppeteer-core": "25.16.0",
    "@puppeteer/browsers": "latest"
  }
}
